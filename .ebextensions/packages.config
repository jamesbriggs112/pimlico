packages:
  yum:
    php8.4-pecl-apcu: []
    patch: []

commands:
  01_symlink_apcu:
    # Forces a symlink from the versioned package directory to the primary EB PHP directory
    command: "ln -sf /usr/lib64/php8.4/modules/apcu.so /usr/lib64/php/modules/apcu.so"

files:
  "/etc/php.d/40-apcu.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      extension=apcu.so
      apc.enabled=1
      apc.shm_size=64M
