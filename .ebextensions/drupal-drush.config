files:
  "/usr/local/bin/drush":
    mode: "000755"
    owner: ec2-user
    group: ec2-user
    content: |
      #!/bin/bash
      set -e

      DRUSH_BIN="/var/app/current/vendor/bin/drush"

      if [[ "$(id -un)" == "ec2-user" ]]; then
        exec "$DRUSH_BIN" "$@"
      fi

      exec sudo -n -u ec2-user -- "$DRUSH_BIN" "$@"
