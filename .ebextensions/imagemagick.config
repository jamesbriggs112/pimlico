packages:
  yum:
    gcc: []
    gcc-c++: []
    make: []
    automake: []
    autoconf: []
    libtool: []
    bzip2-devel: []
    libpng-devel: []
    libjpeg-turbo-devel: []
    libtiff-devel: []
    libwmf-devel: []
    freetype-devel: []
    openexr-devel: []
    libxml2-devel: []
    libtool-ltdl-devel: []

commands:
  01_install_libwebp:
    cwd: /tmp
    test: test ! -f /usr/local/lib/libwebp.so
    command: |
      wget https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.2.1.tar.gz
      tar xvzf libwebp-1.2.1.tar.gz
      cd libwebp-1.2.1
      ./configure
      make
      sudo make install

  02_install_imagemagick:
    cwd: /tmp
    test: test ! -f /usr/local/bin/convert
    command: |
      wget https://www.imagemagick.org/download/ImageMagick.tar.gz
      tar xf ImageMagick.tar.gz
      cd ImageMagick-*
      ./configure --with-webp=yes
      make
      sudo make install

  03_run_ldconfig:
    command: sudo ldconfig
