files:
    "/etc/cron.d/cron":
        mode: "000644"
        owner: root
        group: root
        content: |
            * */1 * * * root /usr/local/bin/cron.sh

    "/usr/local/bin/cron.sh":
        mode: "000755"
        owner: root
        group: root
        content: |
            #!/bin/bash
            ENV_VARS_JSON=$(/opt/elasticbeanstalk/bin/get-config environment)
            CRON_URL=$(echo $ENV_VARS_JSON | jq -r '.CRON_URL')
            wget -O - -q -t 1 ${CRON_URL} > /dev/null

commands:
    remove_old_cron:
        command: "rm -f /etc/cron.d/cron.bak"
