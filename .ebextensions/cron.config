files:
    "/etc/cron.d/cron":
        mode: "000644"
        owner: root
        group: root
        content: |
            * * * * * webapp /usr/local/bin/scheduler-cron.sh
            0 * * * * webapp /usr/local/bin/cron.sh

    "/usr/local/bin/scheduler-cron.sh":
        mode: "000755"
        owner: root
        group: root
        content: |
            #!/bin/bash
            /var/app/current/vendor/bin/drush sch-cron

    "/usr/local/bin/cron.sh":
        mode: "000755"
        owner: root
        group: root
        content: |
            #!/bin/bash
            /var/app/current/vendor/bin/drush cron

commands:
    remove_old_cron:
        command: "rm -f /etc/cron.d/cron.bak"
    remove_old_scheduler_cron:
        command: "rm -f /etc/cron.d/scheduler-cron.bak"
