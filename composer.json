{
  "name": "drupal/recommended-project",
  "description": "Project template for Drupal 9 projects with a relocated document root",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/drupal",
  "support": {
    "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
    "chat": "https://www.drupal.org/node/314178"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    },
    {
      "type": "vcs",
      "url": "https://github.com/Four-Agency/media-entity-download-extended.git"
    }
  ],
  "require": {
    "aws/aws-sdk-php": "^3.319",
    "composer/installers": "^2.3",
    "cweagans/composer-patches": "^1.7",
    "drupal/address": "^2.0",
    "drupal/admin_toolbar": "^3.4",
    "drupal/advanced_mega_menu": "^1.1",
    "drupal/block_field": "^1.0@RC",
    "drupal/cloudfront_cache_path_invalidate": "^4.0",
    "drupal/config_ignore": "^3.3",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-project-message": "^11",
    "drupal/core-recipe-unpack": "^11.3",
    "drupal/core-recommended": "^11",
    "drupal/crop": "^2.3",
    "drupal/easy_breadcrumb": "^2.0",
    "drupal/entity_reference_purger": "^1.0@beta",
    "drupal/entity_type_clone": "^4.0",
    "drupal/entityqueue": "^1.6",
    "drupal/fences": "^3.0",
    "drupal/field_group": "^4.0",
    "drupal/focal_point": "^2.0",
    "drupal/gin": "^5.0",
    "drupal/gin_login": "^2.1",
    "drupal/gin_toolbar": "^3.0",
    "drupal/google_tag": "^2.0",
    "drupal/health_check": "^3.1",
    "drupal/image_effects": "^4.0",
    "drupal/imagemagick": "^5.0",
    "drupal/linked_field": "^1.5",
    "drupal/media_duplicates": "^2.0",
    "drupal/media_entity_download": "^2.2",
    "drupal/media_library_edit": "^3.0",
    "drupal/metatag": "^2.0",
    "drupal/migrate_plus": "^6.0",
    "drupal/migrate_tools": "^6.1",
    "drupal/normalized_image_styles": "^2.1",
    "drupal/office_hours": "^1.29",
    "drupal/paragraphs": "^1.15",
    "drupal/paragraphs_ee": "^10.0",
    "drupal/pathauto": "^1.11",
    "drupal/plyr": "^1.0@alpha",
    "drupal/quick_node_clone": "^1.16",
    "drupal/raven": "^7.3",
    "drupal/recaptcha": "^3.4",
    "drupal/recaptcha_v3": "^2.0",
    "drupal/require_login": "^3.0",
    "drupal/robotstxt": "^1.6",
    "drupal/schema_metatag": "^3.0",
    "drupal/search_api": "^1.35",
    "drupal/simple_gmap": "^4.0",
    "drupal/simple_sitemap": "^4.2",
    "drupal/smtp": "^1.2",
    "drupal/storybook": "^1.0",
    "drupal/structure_sync": "^2.0",
    "drupal/svg_image": "^3.0",
    "drupal/tagify": "^2.0",
    "drupal/token_filter": "^2.0",
    "drupal/token_or": "^2.3",
    "drupal/twig_tweak": "^3.3",
    "drupal/viewfield": "^3.0@beta",
    "drupal/views_show_more": "^2.0",
    "drupal/vitals": "^2.5",
    "drupal/vite": "^1.5",
    "drupal/webform": "^6.3@beta",
    "drush/drush": "^13.6",
    "marmelo/media_entity_download_extended": "^3.0",
    "npm-asset/plyr": "^3.7",
    "oomphinc/composer-installers-extender": "^2.0",
    "wikimedia/composer-merge-plugin": "^2.1"
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "drupal/core-recipe-unpack": true,
      "oomphinc/composer-installers-extender": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true,
      "tbachert/spi": true,
      "wikimedia/composer-merge-plugin": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Drupal\\four_sdc\\": "web/modules/custom/four_sdc/src/"
    }
  },
  "extra": {
    "enable-patching": true,
    "composer-exit-on-patch-failure": true,
    "patches": {
      "drupal/focal_point": {
        "limit image styles in preview": "https://www.drupal.org/files/issues/2024-11-14/2830678-44-focal-preview-limit.patch"
      },
      "drupal/crop": {
        "fix provider fallback loop clobbering crop (drops ?h= hash)": "patches/crop-fallback-loop-first-hit.patch"
      },
      "drupal/viewfield": {
        "fix viewfield php error": "https://www.drupal.org/files/issues/2023-08-21/3381787.patch"
      },
      "drupal/storybook": {
        "#3442952": "https://www.drupal.org/files/issues/2025-05-29/storybook-fix-issues-with-symlinks-3442952-13.patch"
      },
      "drupal/plyr": {
        "Load library locally": "https://www.drupal.org/files/issues/2024-09-05/plyr_libraries_npm_assets-3.patch"
      }
    },
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      },
      "file-mapping": {
        "[web-root]/sites/default/services.yml": "scaffold/services.yml",
        "[web-root]/sites/example.settings.local.php": "scaffold/example.settings.local.php",
        "[web-root]/sites/development.services.yml": {
          "mode": "replace",
          "path": "scaffold/development.services.yml",
          "overwrite": true
        },
        "[web-root]/.htaccess": "scaffold/.htaccess",
        "[web-root]/robots.txt": false
      }
    },
    "installer-types": [
      "npm-asset",
      "bower-asset"
    ],
    "installer-paths": {
      "recipes/{$name}": [
        "type:drupal-recipe"
      ],
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library",
        "type:npm-asset",
        "type:bower-asset"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "web/modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "web/profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "web/themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ]
    },
    "drupal-core-project-message": {
      "include-keys": [
        "homepage",
        "support"
      ],
      "post-create-project-cmd-message": [
        "<bg=blue;fg=white>                                                         </>",
        "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
        "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
        "<bg=blue;fg=white>                                                         </>",
        "",
        "<bg=yellow;fg=black>Next steps</>:",
        "  * Install the site: https://www.drupal.org/docs/installing-drupal",
        "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
        "  * Get support: https://www.drupal.org/support",
        "  * Get involved with the Drupal community:",
        "      https://www.drupal.org/getting-involved",
        "  * Remove the plugin that prints this message:",
        "      composer remove drupal/core-project-message"
      ]
    },
    "merge-plugin": {
      "include": [
        "web/modules/contrib/webform/composer.libraries.json"
      ]
    }
  },
  "require-dev": {
    "chi-teck/drupal-code-generator": "^4.2",
    "drupal/coder": "^8.3",
    "drupal/core-dev": "^11.4",
    "squizlabs/php_codesniffer": "^3.7"
  }
}
