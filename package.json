  "scripts": {
    "postinstall": "husky",
    "build:four_starterkit": "yarn workspace four_starterkit build",
    "dev:four_starterkit": "yarn workspace four_starterkit dev"
  },
  "devDependencies": {
    "husky": "^9.1.5"
