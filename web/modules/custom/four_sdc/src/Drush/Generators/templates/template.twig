{% set classes = [
  component_machine_name|lower|replace({'_': '-'}),
	class
] %}

<div {{ '{{ attributes.addClass(classes) }}' }}>
	{% if component_slots|length > 0 %}
		{% for slot in component_slots %}
			{{ '{% block ' }}
			{{ slot.name }}
			{{ ' %}' }}
			{# {{ slot.title|lower|replace({' ': '-'}) }} content #}
			{{ '{% endblock %}' }}
		{% endfor %}
	{% endif %}
</div>
