{% if items %}
  <nav class="pagination" aria-labelledby="{{ heading_id }}">
    <h2 id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</h2>
    <ul class="pagination__items js-pager__items">
      {% if items.previous %}
        <li class="pagination__item pagination__item--step">
          <a class="pagination__step" href="{{ items.previous.href }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>{{ items.previous.text|default('Previous'|t) }}</a>
        </li>
      {% endif %}
      {% if ellipses.previous %}<li class="pagination__item" role="presentation">&hellip;</li>{% endif %}
      {% for key, item in items.pages %}
        <li class="pagination__item">
          {# The current page is text, not a link back to itself. #}
          {% if current == key %}
            <span class="pagination__page" aria-current="page"><span class="visually-hidden">{{ 'Page'|t }}</span>{{ key }}</span>
          {% else %}
            <a class="pagination__page" href="{{ item.href }}"{{ item.attributes|without('href', 'title', 'aria-current') }}>
              <span class="visually-hidden">{{ 'Page'|t }}</span>{{ key }}
            </a>
          {% endif %}
        </li>
      {% endfor %}
      {% if ellipses.next %}<li class="pagination__item" role="presentation">&hellip;</li>{% endif %}
      {% if items.next %}
        <li class="pagination__item pagination__item--step">
          <a class="pagination__step" href="{{ items.next.href }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>{{ items.next.text|default('Next'|t) }}</a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
