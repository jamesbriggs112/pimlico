{% set attributes = attributes ?: create_attribute() %}
{% set attributes = attributes|without('class') %}
{% set tone = tone|default(color ? 'dark' : 'light') %}

{% set classes = [
  'btn-icon',
  'btn-icon--' ~ tone,
  class,
] %}

{% if pressed is defined and pressed is not null %}
  {% set attributes = attributes.setAttribute('aria-pressed', pressed ? 'true' : 'false') %}
{% endif %}

<button {{ attributes.addClass(classes).setAttribute('type', 'button') }}>
  {% block icon %}
    {% if icon_name %}
      {% include 'pimlico:icon' with { name: icon_name, size: 20 } only %}
    {% endif %}
  {% endblock %}
  {% embed 'pimlico:visually_hidden' with { title } only %}
    {% block content %}{{ title }}{% endblock %}
  {% endembed %}
</button>
