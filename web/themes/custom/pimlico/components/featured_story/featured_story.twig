{% set attributes = attributes ?: create_attribute() %}
{% set tag = url ? 'a' : 'div' %}
<section {{ attributes.addClass('featured-story') }}>
  <div class="featured-story__inner">
    <div class="featured-story__image">{% block image %}{{ image }}{% endblock %}</div>
    {# An attribute object, so the URL is escaped once (a string attribute
       was escaped whole and broke the link). #}
    {% set text_attributes = create_attribute({ class: ['featured-story__text'] }) %}
    {% if url %}{% set text_attributes = text_attributes.setAttribute('href', url) %}{% endif %}
    <{{ tag }}{{ text_attributes }}>
      {% if logo %}<div class="featured-story__logo">{% block logo %}{{ logo }}{% endblock %}</div>{% endif %}
      {% if meta %}<p class="featured-story__meta eyebrow">{{ meta }}</p>{% endif %}
      {% if title %}<h2 class="featured-story__title display-l">{{ title }}</h2>{% endif %}
      {% if summary %}<p class="featured-story__summary body-l">{{ summary }}</p>{% endif %}
      {% if reading_time %}<p class="featured-story__time body-s">{{ reading_time }}</p>{% endif %}
      {% if url and link_text %}<span class="featured-story__link" aria-hidden="true">{{ link_text }}</span>{% endif %}
    </{{ tag }}>
  </div>
</section>
