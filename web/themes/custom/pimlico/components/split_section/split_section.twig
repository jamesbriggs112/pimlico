{% set attributes = attributes ?: create_attribute() %}
{% set heading_id = 'split-' ~ heading|clean_id %}
<section {{ attributes.addClass(['split-section', tint ? 'split-section--tint']).setAttribute('aria-labelledby', heading_id) }}>
  <div class="split-section__inner">
    <div class="split-section__intro">
      {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
      <h2 class="split-section__heading display-l" id="{{ heading_id }}">{{ heading }}</h2>
      {% if intro %}<p class="split-section__text body-l">{{ intro }}</p>{% endif %}
    </div>
    <div class="split-section__content">
      {% block content %}{{ content }}{% endblock %}
      {% if links %}
        <div class="split-section__actions">
          {% for link in links %}
            {% include 'pimlico:button' with { text: link.text, url: link.url, variant: 'yellow' } only %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
