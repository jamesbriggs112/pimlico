{%
  set classes = [
    'content-carousel',
		color ? 'content-carousel--' ~ color,
		color ? 'is-flush',
  ]
%}

{% set opposite_color = color == 'primary' ? 'secondary' : 'primary' %}

<section {{ attributes.addClass(classes) }} data-component-id="pimlico:content_carousel">
	<div class="content-carousel__wrapper">
		<header class="content-carousel__header">
			{% if title %}
				{% block title %}
					{% embed "pimlico:heading" with {tag: 'h2'}  %}
						{% block content %}
							{{ title }}
						{% endblock %}
					{% endembed %}
				{% endblock %}
			{% endif %}
			<div class="content-carousel__controls" role="group" aria-label="Carousel controls">
				{% embed "pimlico:button_icon" with {title: 'Go to previous slide', class: 'content-carousel__prev', color: opposite_color}  %}
					{% block icon %}
						<svg class="icon icon-chevron-left" aria-hidden="true" focusable="false" fill="currentColor" viewbox="0 0 24 24">
							<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/>
						</svg>
					{% endblock %}
				{% endembed %}

				{% embed "pimlico:button_icon" with {title: 'Go to next slide', class: 'content-carousel__next', color: opposite_color}  %}
					{% block icon %}
						<svg class="icon icon-chevron-right" aria-hidden="true" focusable="false" fill="currentColor" viewbox="0 0 24 24">
							<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/>
						</svg>
					{% endblock %}
				{% endembed %}
			</div>
		</header>
		<div class="content-carousel__viewport">
			<div class="content-carousel__container" aria-label="Carousel content">
				{% block slides %}
					{# Carousel slides go here #}
				{% endblock %}
			</div>
		</div>
	</div>
</section>
