{#
/**
 * @file
 * Generic section wrapper for paragraph types without their own template:
 * an optional h2 heading and the rendered fields.
 */
#}
{% set attributes = attributes ?: create_attribute() %}
<section {{ attributes.addClass('paragraph') }}>
  {% if heading %}
    {% block heading %}
      {% embed "pimlico:heading" with {tag: 'h2'} %}
        {% block content %}
          {{ heading }}
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endif %}
  {% block content %}
    {{ content }}
  {% endblock %}
</section>
