{% set attributes = attributes ?: create_attribute() %}
<nav {{ attributes.addClass(['filter-bar', 'filter-bar--' ~ align|default('center')]).setAttribute('aria-label', label|default('Filter'|t)) }}>
  <ul class="filter-bar__list">
    {% for item in items %}
      <li>
        {# The active filter is the current page: text, not a link back to it. #}
        {% if item.active %}
          <span class="filter-bar__link" aria-current="true">{{ item.text }}</span>
        {% else %}
          <a class="filter-bar__link" href="{{ item.url }}">{{ item.text }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
