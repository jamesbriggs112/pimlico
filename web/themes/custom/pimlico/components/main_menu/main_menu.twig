{#
/**
 * @file
 * Main navigation (Figma "Header" and "Mobile nav item").
 *
 * Desktop: the first `split` items sit left of the logo and the rest right.
 * Mobile: the same links, stacked, inside the mobile menu. One level only:
 * no drop-downs.
 */
#}
{% set attributes = attributes ?: create_attribute() %}
{% set split = split|default(3) %}
{% import _self as menu %}

{% macro item(item) %}
  {% set link_classes = ['text-link', 'text-link--caps', 'main-menu__link', item.in_active_trail ? 'text-link--underlined'] %}
  <li class="main-menu__item">
    <a class="{{ link_classes|join(' ') }}" href="{{ item.url }}"{{ item.in_active_trail ? ' aria-current="page"' }}>
      <span class="text-link__text">{{ item.title }}</span>
    </a>
  </li>
{% endmacro %}

{% if items %}
  <nav {{ attributes.addClass('main-menu').setAttribute('aria-label', label|default('Main'|t)) }}>
    <ul class="main-menu__list main-menu__list--start">
      {% for item in items|slice(0, split) %}
        {{ menu.item(item) }}
      {% endfor %}
    </ul>
    <ul class="main-menu__list main-menu__list--end">
      {% for item in items|slice(split) %}
        {{ menu.item(item) }}
      {% endfor %}
    </ul>
  </nav>
{% endif %}
