{% set attributes = attributes ?: create_attribute() %}
{% set attributes = attributes|without('class') %}
{% set variant = variant|default('yellow') %}

{% set classes = [
  'btn',
  'btn--' ~ variant,
  full_width ? 'btn--full-width',
  class,
] %}

{% if url %}
  {% if external %}
    {% set attributes = attributes.setAttribute('target', '_blank').setAttribute('rel', 'noopener') %}
  {% endif %}
  {# The new-tab note is hidden text, not an aria-label built from the
     text, so a name like "House & Garden" is escaped once. #}
  <a {{ attributes.addClass(classes).setAttribute('href', url) }}>{{ text }}{% if external %}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>{% endif %}</a>
{% else %}
  <button {{ attributes.addClass(classes) }}>{{ text }}</button>
{% endif %}
