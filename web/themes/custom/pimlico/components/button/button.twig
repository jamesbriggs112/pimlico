{% set attributes = attributes ?: create_attribute() %}
{% set attributes = attributes|without('class') %}
{% set variant = variant|default(color == 'secondary' ? 'yellow' : 'dark') %}

{% set classes = [
  'btn',
  'btn--' ~ variant,
  full_width ? 'btn--full-width',
  class,
] %}

{% if url %}
  <a {{ attributes.addClass(classes).setAttribute('href', url) }}>{{ text }}</a>
{% else %}
  <button {{ attributes.addClass(classes) }}>{{ text }}</button>
{% endif %}
