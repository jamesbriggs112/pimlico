{% set attributes = attributes ?: create_attribute() %}
<section {{ attributes.addClass(['policy', contents ? 'policy--contents' : '']) }}>
  {% if contents %}
    <nav class="policy__contents" id="contents" aria-labelledby="policy-contents-label">
      <p class="eyebrow policy__label" id="policy-contents-label">{{ 'On this page'|t }}</p>
      <ol class="policy__list">
        {% for item in contents %}
          <li class="policy__item">
            <a class="policy__link" href="#{{ item.id }}">
              <span class="policy__title">{{ item.title }}</span>
              <span class="policy__number body-s" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
            </a>
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% endif %}
  <div class="policy__body">
    {% if updated %}<p class="eyebrow policy__updated">{{ 'Last updated · @date'|t({ '@date': updated }) }}</p>{% endif %}
    <div class="rich-text rich-text--start policy__text">{% block body %}{{ body }}{% endblock %}</div>
    {% if contents %}
      <div class="policy__actions">
        {% include 'pimlico:button' with { text: 'Back to contents'|t, url: '#contents', variant: 'yellow' } only %}
      </div>
    {% endif %}
  </div>
</section>
