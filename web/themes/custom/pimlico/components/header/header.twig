{% set attributes = attributes ?: create_attribute() %}
{% set classes = ['header', overlay ? 'header--overlay'] %}

<header {{ attributes.addClass(classes) }}>
  <div class="header__inner">
    {# The burger turns into a cross while the menu is open, and closes it. #}
    <button class="header__icon-button header__menu-toggle" type="button" aria-expanded="false" aria-controls="header-nav">
      <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">{{ 'Menu'|t }}</span>
    </button>

    {% include 'pimlico:logo' with {
      url: home_url|default('/'),
      label: 'The Pimlico Road home'|t,
      tone: overlay ? 'light' : 'dark',
      attributes: create_attribute({ class: ['header__logo'] }),
    } only %}

    <div class="header__nav" id="header-nav">
      <div class="header__nav-primary">
        {% block primary_menu %}{{ primary_menu }}{% endblock %}
      </div>

      <div class="header__nav-secondary">
        {% block secondary_menu %}{{ secondary_menu }}{% endblock %}
      </div>

      <div class="header__nav-actions">
        {% include 'pimlico:button' with { text: 'Plan your visit'|t, url: visit_url|default('/visit'), variant: 'yellow', full_width: true } only %}
        {% include 'pimlico:button' with { text: 'Sign up to the newsletter'|t, url: newsletter_url|default('#newsletter'), variant: 'yellow', full_width: true, attributes: create_attribute({ class: ['header__newsletter-link'] }) } only %}
      </div>
    </div>

    <a class="header__icon-button header__search" href="{{ search_url|default('/search') }}">
      {% include 'pimlico:icon' with { name: 'search' } only %}
      <span class="visually-hidden">{{ 'Search'|t }}</span>
    </a>
  </div>
</header>
