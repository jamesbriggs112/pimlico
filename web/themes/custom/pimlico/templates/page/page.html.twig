{#
/**
 * @file
 * Page layout: header, main content, newsletter band and footer.
 */
#}
{# Pages that open with a film hero get the transparent header over it. #}
{% set first_section = node.field_sections.entity ?? null %}
{% set header_overlay = node.bundle is defined and first_section and first_section.bundle() == 'hero_film' %}
<div {{ attributes.addClass('page') }}>
  {% block header %}
    {% embed 'pimlico:header' with {
      primary_menu: page.primary_menu,
      overlay: header_overlay ? true : false,
    } only %}
      {% block secondary_menu %}
        {{ drupal_menu('footer-information', 1, 1) }}
        {{ drupal_menu('social-media', 1, 1) }}
      {% endblock %}
    {% endembed %}
  {% endblock %}

  {# Node pages are stacks of full-width sections that set their own widths.
     Other pages (access denied, not found, login, search) get the Page
     title band and the content column. #}
  <main id="main-content"{{ node or is_view_page ? '' : ' class="main main--contained"' }}>
    {% block main_content %}
      {% if not node and not is_view_page %}
        {% set title = drupal_title()|render|striptags|trim %}
        {% if title %}
          {% include 'pimlico:page_title' with { title } only %}
        {% endif %}
        <div class="main__content">{{ page.content }}</div>
      {% else %}
        {{ page.content }}
      {% endif %}
    {% endblock %}
  </main>

  {% if page.newsletter %}
    <div class="newsletter-region" id="newsletter">
      {{ page.newsletter }}
    </div>
  {% endif %}

  {% block footer %}
    {% embed 'pimlico:footer' with {
      menu: page.footer_menu,
      bottom: page.footer_bottom,
    } only %}
    {% endembed %}
  {% endblock %}

  {# page.mega_menu_blocks is a holding region for Advanced Mega Menu and is
     never printed: its blocks appear inside mega menu panels. #}
</div>
