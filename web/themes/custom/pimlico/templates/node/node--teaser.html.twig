{#
/**
 * @file
 * Teaser: a story card. Bundles add their own meta and image in
 * node--BUNDLE--teaser templates; this is the fallback (pages use their
 * share image).
 */
#}
{% embed 'pimlico:story_card' with {
  attributes,
  url: url,
  title: label|render|striptags|trim,
  meta: node.type.entity.label,
  image: content.field_seo_image,
  link_text: 'Read more'|t,
} only %}
{% endembed %}
