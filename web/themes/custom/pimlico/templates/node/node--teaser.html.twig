{#
/**
 * @file
 * Teaser → story card. Stories show "Type · date", such as "News · 4 Nov"
 * (story_type, from pimlico_preprocess_node()); other types fall back to
 * their share image. Brands have node--brand--teaser.
 */
#}
{% set meta = story_type
  ? [story_type, node.created.value|format_date('custom', 'j M')]|join(' · ')
  : '' %}
{% include 'pimlico:story_card' with {
  attributes,
  url,
  title: node.label,
  meta,
  image: story_type ? content.field_image : content.field_seo_image,
  link_text: story_type ? (node.bundle == 'press_article' ? 'Read the coverage'|t : 'Read'|t) : 'Read more'|t,
} only %}
