{#
/**
 * @file
 * Form paragraph → pimlico:form_section, around the referenced Webform.
 */
#}
{% include 'pimlico:form_section' with {
  attributes,
  eyebrow: paragraph.field_eyebrow.value|default(''),
  heading: paragraph.field_heading.value|default(''),
  text: content.field_text,
  form: content.field_webform,
} only %}
