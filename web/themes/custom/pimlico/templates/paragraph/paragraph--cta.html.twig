{#
/**
 * @file
 * Next step paragraph (cta) → pimlico:next_step.
 */
#}
{% set links = [] %}
{% for item in paragraph.field_links %}
  {% set links = links|merge([{ text: item.title, url: item.url.toString() }]) %}
{% endfor %}
{% include 'pimlico:next_step' with {
  attributes,
  eyebrow: paragraph.field_eyebrow.value|default(''),
  heading: paragraph.field_heading.value|default(''),
  text: content.field_text,
  links,
} only %}
