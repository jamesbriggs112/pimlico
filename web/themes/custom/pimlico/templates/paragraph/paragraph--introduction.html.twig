{#
/**
 * @file
 * Introduction paragraph → pimlico:introduction.
 *
 * Two images make the collage; none gives the centred layout, with the
 * optional film below. Empty fields pass null: an empty field still renders
 * (its cache metadata), which would print the component's empty wrapper.
 */
#}
{% set link = paragraph.field_link.0 %}
{% include 'pimlico:introduction' with {
  attributes,
  eyebrow: paragraph.field_eyebrow.value|default(''),
  heading: paragraph.field_heading.value|default(''),
  link_text: link.title|default(''),
  link_url: link ? link.url.toString() : '',
  text: content.field_text,
  image_large: content.field_images[0],
  image_small: content.field_images[1],
  media: paragraph.field_video.isEmpty() ? null : content.field_video,
} only %}
