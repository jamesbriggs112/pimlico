{#
/**
 * @file
 * Cards paragraph → pimlico:card_grid. Hand-picked items, or else the
 * latest three Stories (Home "This week"); both render as teasers. The
 * skeleton's field_view listing (every node type) isn't used. A Dark
 * background arrives as the is-inverse class on attributes (see
 * pimlico_preprocess_paragraph()).
 *
 * With "Show Brand intros" on, hand-picked Brands render in the
 * teaser_summary view mode (the card with the Brand's intro, as on Newson's
 * Yard "Resident brands"); other items stay teasers. drupal_entity() checks
 * access and adds cache tags as the field formatter does.
 */
#}
{% set link = paragraph.field_link.0 %}
{% if paragraph.field_background.value == 'linen' %}
  {% set attributes = attributes.addClass('card-grid--tint') %}
{% endif %}
{% set items = content.field_content %}
{% if paragraph.field_show_summaries.value %}
  {% set items = paragraph.field_content|map(item => drupal_entity('node', item.target_id, item.entity.bundle == 'brand' ? 'teaser_summary' : 'teaser')) %}
{% endif %}
{% include 'pimlico:card_grid' with {
  attributes,
  eyebrow: paragraph.field_eyebrow.value|default(''),
  heading: paragraph.field_heading.value|default(''),
  link_text: link.title|default(''),
  link_url: link ? link.url.toString() : '',
  text: content.field_text,
  items: paragraph.field_content.isEmpty() ? drupal_view('news', 'block_latest') : items,
} only %}
