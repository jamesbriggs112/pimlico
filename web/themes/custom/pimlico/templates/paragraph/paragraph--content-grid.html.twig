{#
/**
 * @file
 * Cards paragraph → pimlico:card_grid. Hand-picked items win over the
 * listing; both render as teasers (story cards).
 */
#}
{% set link = paragraph.field_link.0 %}
{% if paragraph.field_anchor.value %}
  {% set attributes = attributes.setAttribute('id', paragraph.field_anchor.value) %}
{% endif %}
{% include 'pimlico:card_grid' with {
  attributes,
  eyebrow: paragraph.field_eyebrow.value|default(''),
  heading: paragraph.field_heading.value|default(''),
  link_text: link.title|default(''),
  link_url: link ? link.url.toString() : '',
  text: content.field_text,
  items: paragraph.field_content.isEmpty() ? content.field_view : content.field_content,
} only %}
