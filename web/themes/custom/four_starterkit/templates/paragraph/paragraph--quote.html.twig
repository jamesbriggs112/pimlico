{% embed "four_starterkit:paragraph" with {
  view_mode,
  paragraph,
  attributes,
} %}
	{% block content %}
		{% embed "four_starterkit:quote" with {
        color: paragraph.field_colour.value|default('primary'),
    } %}
			{% block quote %}
				{{ content.field_text }}
			{% endblock %}
			{% block cite %}
				{% embed "four_starterkit:cite" %}
					{% block cite %}
						{{ content|without('field_text') }}
					{% endblock %}
				{% endembed %}
			{% endblock %}
		{% endembed %}
	{% endblock %}
{% endembed %}
