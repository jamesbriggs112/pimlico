{% set node = paragraph.getParentEntity() %}
{% set title = paragraph.field_heading.value is not empty ? paragraph.field_heading : node.label %}
{% block paragraph %}
	{% embed 'four_starterkit:card' with {
	url: path('entity.node.canonical', {'node': node.id}),
	linkTitle: title
} %}
		{% block image %}
			{{ content.field_image }}
		{% endblock %}
		{% block content %}
			{% embed "four_starterkit:heading" with {tag: 'h3'} %}
				{% block content %}
					{{ title }}
				{% endblock %}
			{% endembed %}
			{{content.field_text}}
		{% endblock %}
	{% endembed %}
{% endblock paragraph %}
