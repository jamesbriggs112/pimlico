use Drupal\Component\Utility\Html;
use Drupal\taxonomy\Entity\Term;

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */
function four_starterkit_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Preprocess functions for the Marmelo base theme .**/
function four_starterkit_preprocess_html(&$variables) {
  // ADD e.g. FONTS IN HERE
  // example: drupal_add_css('https://fonts.googleapis.com/css?family=Montserrat:300,400,500', array('type' => 'external'));.
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    if ($node->hasField('field_theme')) {
      $theme = $node->get('field_theme')->value;
      $variables['attributes']['class'][] = 'theme-' . $theme;
    }

    if ($node->hasField('field_space_type')) {
      $space = Term::load($node->get('field_space_type')->target_id);
      $variables['attributes']['class'][] = 'space-' . Html::getClass($space->getName());
    }
  }
}

