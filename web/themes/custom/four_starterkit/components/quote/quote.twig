{% set attributes = attributes ? create_attribute() %}
{% set classes = [ 'quote',  color ? 'quote--' ~ color ] %}

<div {{ attributes.addClass(classes) }}>
	<blockquote>
		{% block quote %}
			{# Quote content goes here #}
		{% endblock %}
	</blockquote>
	{% block cite %}
		{# Citation content goes here #}
	{% endblock %}
</div>
