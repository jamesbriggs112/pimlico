{% set attributes = attributes|without('class') %}

{% set classes = [
	'btn',
	color ? 'btn--' ~ color|default('primary'),
	class
] %}

{% if url %}
	<a {{ attributes.addClass(classes).setAttribute('href', url) }}>
		{{ text }}
	</a>
{% else %}
	<button {{ attributes.addClass(classes) }}>
		{{ text }}
	</button>
{% endif %}
