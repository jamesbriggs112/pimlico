<?php

use Drupal\Component\Utility\Html;
use Drupal\taxonomy\Entity\Term;

/** Preprocess functions for the Marmelo base theme **/

function four_preprocess_html(&$variables)
{
    // ADD e.g. FONTS IN HERE
    // example: drupal_add_css('https://fonts.googleapis.com/css?family=Montserrat:300,400,500', array('type' => 'external'));
    if ($node = \Drupal::routeMatch()->getParameter('node')) {
        if ($node->hasField('field_theme')) {
            $theme = $node->get('field_theme')->value;
            $variables['attributes']['class'][] = 'theme-' . $theme;
        }

        if ($node->hasField('field_space_type')) {
            $space =  Term::load($node->get('field_space_type')->target_id);
            $variables['attributes']['class'][] = 'space-' . Html::getClass($space->getName());
        }
    }
}

